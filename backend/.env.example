# ═══════════════════════════════════════════════════════════════════════════════
#  ASM Platform v2 — Environment Configuration
#  ALL keys are defined here. If a key is left empty the feature will
#  gracefully skip that provider — but the KEY MUST EXIST in this file.
#  Never commit real keys to git. Copy this to .env and fill in values.
# ═══════════════════════════════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────────────────────────
APP_NAME=ASM Platform
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_SECRET

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://asm_user:asm_password@postgres:5432/asm_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ═══════════════════════════════════════════════════════════════════════════════
#  AI PROVIDERS  — fill in at least ONE key to enable AI analysis
#  All keys must be present even if empty
# ═══════════════════════════════════════════════════════════════════════════════

# Google Gemini (PRIMARY — required)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic Claude (fallback)
# Get key: https://console.anthropic.com/
CLAUDE_API_KEY=

# OpenAI GPT-4 (fallback)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Cohere (fallback)
# Get key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
#  THREAT INTELLIGENCE — fill in keys to enable enrichment
#  All keys must be present even if empty (app passes gracefully if empty)
# ═══════════════════════════════════════════════════════════════════════════════

# VirusTotal (PRIMARY — required for IP/domain reputation)
# Get key: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Shodan (PRIMARY — required for internet scanning data)
# Get key: https://account.shodan.io/
SHODAN_API_KEY=

# Censys (secondary)
# Get keys: https://search.censys.io/account/api
CENSYS_API_ID=
CENSYS_API_SECRET=

# AbuseIPDB — direct REST (no broken pip package)
# Get key: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# GreyNoise
# Get key: https://viz.greynoise.io/account/api-key
GREYNOISE_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
#  PROJECTDISCOVERY TOOLS (Go-based, run via Docker)
#  Tools: subfinder, httpx, naabu, nuclei, dnsx, nmap
#  Docs: https://docs.projectdiscovery.io/opensource
# ═══════════════════════════════════════════════════════════════════════════════

# ProjectDiscovery Cloud API (optional — for nuclei templates sync)
# Get key: https://cloud.projectdiscovery.io/
PDCP_API_KEY=

# Path where PD tool binaries are mounted in container
PD_TOOLS_PATH=/usr/local/bin

# Screenshot tool — gowitness (Go-based)
# https://github.com/sensepost/gowitness
SCREENSHOT_TIMEOUT=30
SCREENSHOT_THREADS=5
SCREENSHOT_OUTPUT_DIR=/app/screenshots

# ═══════════════════════════════════════════════════════════════════════════════
#  SECRET DETECTION
# ═══════════════════════════════════════════════════════════════════════════════

# GitHub token for repo scanning
# Get: https://github.com/settings/tokens
GITHUB_TOKEN=

# ═══════════════════════════════════════════════════════════════════════════════
#  NOTIFICATIONS
# ═══════════════════════════════════════════════════════════════════════════════

# Slack
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# Microsoft Teams
AZURE_TEAMS_WEBHOOK_URL=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=asm-alerts@yourdomain.com

# ═══════════════════════════════════════════════════════════════════════════════
#  SCAN SCHEDULER
# ═══════════════════════════════════════════════════════════════════════════════
CONTINUOUS_SCAN_INTERVAL_HOURS=6
MAX_CONCURRENT_SCANS=5
SCAN_TIMEOUT_SECONDS=3600

# ═══════════════════════════════════════════════════════════════════════════════
#  SHANNON AI PENTESTER (https://github.com/KeygraphHQ/shannon)
#  Autonomous white-box AI pentester — uses Claude to analyze source code
#  and execute real exploits (injection, XSS, SSRF, auth bypass)
#  Install: npx @keygraph/shannon setup
# ═══════════════════════════════════════════════════════════════════════════════

# Anthropic key used by Shannon (same as CLAUDE_API_KEY is fine)
SHANNON_ANTHROPIC_API_KEY=

# Shannon output directory (reports saved here)
SHANNON_OUTPUT_DIR=/app/shannon-reports

# Shannon workspace directory
SHANNON_WORKSPACE_DIR=/app/shannon-workspaces

# Max concurrent Shannon pipelines (1-5, lower = less API cost)
SHANNON_MAX_CONCURRENT_PIPELINES=2

# Shannon model tiers (uses Claude by default)
SHANNON_SMALL_MODEL=claude-haiku-4-5-20251001
SHANNON_MEDIUM_MODEL=claude-sonnet-4-6
SHANNON_LARGE_MODEL=claude-opus-4-7

# Claude Code max output tokens for Shannon
CLAUDE_CODE_MAX_OUTPUT_TOKENS=64000

# ─────────────────────────────────────────────────────────────────────────────
# NOTE: Never leave SECRET_KEY or JWT_SECRET_KEY as default in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────────────────
