# ═══════════════════════════════════════════════════════════════════════════════
#  ASM Platform v2 — Environment Configuration Template
#  Copy this file to `.env` in the same directory and fill in your values.
#  ALL keys must exist in the final `.env` file even if left empty.
# ═══════════════════════════════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────────────────────────
APP_NAME=ASM Platform
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=False
LOG_LEVEL=INFO
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL Connection URL
DATABASE_URL=

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7


# ── Multi-tenant Super Admin bootstrap ───────────────────────────────────────
# On first startup, these create the platform-level Super Admin if it does not exist.
BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=ChangeMe!12345
BOOTSTRAP_SUPER_ADMIN_NAME=Platform Super Admin

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ═══════════════════════════════════════════════════════════════════════════════
#  AI PROVIDERS  — fill in at least ONE key to enable AI analysis
# ═══════════════════════════════════════════════════════════════════════════════

# Google Gemini (PRIMARY — required for AI Pentester)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

GEMINI_SERVICE_ANALYSIS_ENABLED=True
GEMINI_SERVICE_MODEL=gemini-3.6-flash
GEMINI_SERVICE_BATCH_SIZE=20
GEMINI_SERVICE_MAX_UNIQUE_SERVICES=50
GEMINI_SERVICE_TIMEOUT_SECONDS=120
# Anthropic Claude (fallback)
# Get key: https://console.anthropic.com/
CLAUDE_API_KEY=

# OpenAI GPT-4 (fallback)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Cohere (fallback)
# Get key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
#  THREAT INTELLIGENCE — fill in keys to enable enrichment
# ═══════════════════════════════════════════════════════════════════════════════

# VirusTotal (PRIMARY — required for IP/domain reputation)
# Get key: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Shodan (PRIMARY — required for internet scanning data)
# Get key: https://account.shodan.io/
SHODAN_API_KEY=

# Censys (secondary)
# Get keys: https://search.censys.io/account/api
CENSYS_API_ID=PTpXcLEj
CENSYS_API_SECRET=

# AbuseIPDB — direct REST (no broken pip package)
# Get key: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# GreyNoise
# Get key: https://viz.greynoise.io/account/api-key
GREYNOISE_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
#  PROJECTDISCOVERY TOOLS (Go-based, run via Docker)
# ═══════════════════════════════════════════════════════════════════════════════

# ProjectDiscovery Cloud API (optional — for nuclei templates sync)
# Get key: https://cloud.projectdiscovery.io/
PDCP_API_KEY=

# Maximum overall Nuclei runtime in seconds. Use 0 for no overall deadline.
NUCLEI_SCAN_TIMEOUT_SECONDS=0

# Path where PD tool binaries are mounted in container
PD_TOOLS_PATH=/usr/local/pd_tools
NMAP_PATH=/usr/bin/nmap
CHROMIUM_PATH=/usr/bin/chromium
RECON_TOOL_PROBE_ON_SCAN_START=True
RECON_TOOL_PROBE_TIMEOUT_SECONDS=15

# Screenshot tool — gowitness (Go-based)
# https://github.com/sensepost/gowitness
SCREENSHOT_TIMEOUT=30
SCREENSHOT_THREADS=5
SCREENSHOT_OUTPUT_DIR=/app/screenshots

# ═══════════════════════════════════════════════════════════════════════════════
#  SECRET DETECTION
# ═══════════════════════════════════════════════════════════════════════════════

# GitHub token for repo scanning
# Get: https://github.com/settings/tokens
GITHUB_TOKEN=

# ═══════════════════════════════════════════════════════════════════════════════
#  NOTIFICATIONS
# ═══════════════════════════════════════════════════════════════════════════════

# Slack
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# Microsoft Teams
AZURE_TEAMS_WEBHOOK_URL=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=asm-alerts@yourdomain.com

# ═══════════════════════════════════════════════════════════════════════════════
#  SCAN SCHEDULER
# ═══════════════════════════════════════════════════════════════════════════════
CONTINUOUS_SCAN_INTERVAL_HOURS=6
MAX_CONCURRENT_SCANS=5
SCAN_TIMEOUT_SECONDS=3600

# ═══════════════════════════════════════════════════════════════════════════════
#  ADDITIONAL LOCAL SETTINGS & CUSTOM OVERRIDES
# ═══════════════════════════════════════════════════════════════════════════════
API_TITLE=Attack Surface Management Platform
API_VERSION=1.0.0
API_PREFIX=/api/v1
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
WORKERS=4
CORS_CREDENTIALS=True
CORS_METHODS=["*"]
CORS_HEADERS=["*"]
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
RBAC_ENABLED=True
DEFAULT_ROLE=analyst
REDIS_CACHE_TTL=3600
CELERY_TASK_TIMEOUT=3600
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
LOG_FORMAT=json
STRUCTLOG_ENABLED=True
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_SPECIAL=True
PASSWORD_REQUIRE_NUMBERS=True
PASSWORD_REQUIRE_UPPERCASE=True
WHOIS_CACHE_TTL=604800
DNS_CACHE_TTL=86400
SSL_CHECK_TIMEOUT=10

# Extended passive asset discovery
SUBLIST3R_ENABLED=True
UNCOVER_ENABLED=True
UNCOVER_ENGINE=shodan-idb
UNCOVER_LIMIT=50

# Historical URL, parameter and crawler stages
WAYBACKURLS_ENABLED=True
PARAMSPIDER_ENABLED=True
KATANA_ENABLED=True
KATANA_DEPTH=2
MAX_DISCOVERED_URLS=2000

# Web content discovery
DIRSEARCH_ENABLED=True
DIRSEARCH_MAX_TARGETS=5
DIRSEARCH_TIMEOUT_SECONDS=240
DIRSEARCH_MAX_RATE=20

# Content discovery
DIRB_ENABLED=True
DIRB_MAX_TARGETS=3
DIRBUSTER_ENABLED=True
DIRBUSTER_MAX_TARGETS=2

# Technology detection
WAPPALYZER_ENABLED=True
WAPPALYZER_MAX_TARGETS=20

# Conditional CMS checks
WPSCAN_ENABLED=True
WPSCAN_API_TOKEN=
WPSCAN_MAX_TARGETS=5
WPSCAN_TIMEOUT_SECONDS=600
DROOPESCAN_ENABLED=True
DROOPESCAN_MAX_TARGETS=5
DROOPESCAN_TIMEOUT_SECONDS=300

# JavaScript secret-pattern discovery
SECRETFINDER_ENABLED=True
SECRETFINDER_MAX_JAVASCRIPT_URLS=30

# Active XSS testing
XSSTRIKE_ENABLED=True
XSSTRIKE_MAX_TARGETS=10
XSSTRIKE_TIMEOUT_SECONDS=180

# XSS Vibes
XSSVIBES_ENABLED=True
XSSVIBES_MAX_TARGETS=20
XSSVIBES_THREADS=5
XSSVIBES_TIMEOUT_SECONDS=300

# Nikto
NIKTO_ENABLED=True
NIKTO_MAX_TARGETS=5
NIKTO_TIMEOUT_SECONDS=420

# Meta-wrapper tool
LAZYRECON_ENABLED=True
LAZYRECON_TIMEOUT_SECONDS=1800
